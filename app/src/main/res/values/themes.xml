<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#5FDCFF</item>
        <item name="colorPrimaryVariant">#2E3B4D</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#5FDCFF</item>
        <item name="colorSecondaryVariant">#3A879D</item>
        <item name="colorOnSecondary">#0A0A0A</item>
        <item name="android:statusBarColor">#0A0A0A</item>
        <item name="android:navigationBarColor">#0A0A0A</item>
    </style>

    <style name="TextAppearance.TitleGradient" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">#5FDCFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:shadowColor">#335FDCFF</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
        <item name="android:shadowRadius">8</item>
    </style>

    <style name="InputStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">#5FDCFF</item>
        <item name="hintTextColor">#7FFFFFFF</item>
        <item name="android:textColorHint">#7FFFFFFF</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="ControlButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="iconTint">@color/white</item>
        <item name="iconSize">24dp</item>
        <item name="iconPadding">8dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Button</item>
    </style>

    <style name="ShapeAppearance.Button" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">12dp</item>
    </style>
</resources>